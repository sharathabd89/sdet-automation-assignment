<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Quick health check: only tests tagged "smoke" (UI + API). -->
<suite name="Smoke Suite" parallel="methods" thread-count="4">

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.sdet.ui"/>
            <package name="com.sdet.api"/>
        </packages>
    </test>
</suite>
