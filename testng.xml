<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: UI + API. Test methods run in parallel; each UI test gets its own browser. -->
<suite name="Full Regression Suite" parallel="methods" thread-count="4">

    <test name="UI Tests">
        <packages>
            <package name="com.sdet.ui"/>
        </packages>
    </test>

    <test name="API Tests">
        <packages>
            <package name="com.sdet.api"/>
        </packages>
    </test>
</suite>
